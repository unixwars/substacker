{
  "name": "substacker-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Reads a Substack feed, stores the backup and derives the served files.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "substacker-scrape": "./dist/bin/scrape.js",
    "substacker-build": "./dist/bin/build.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.12.0",
    "jsdom": "^31.0.0",
    "substacker-core": "^0.1.0"
  }
}
