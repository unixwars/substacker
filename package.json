{
  "name": "substacker-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Back up a Substack as static files and read it offline.",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/core",
    "packages/scraper",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.ts",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "publish:dry-run": "node scripts/publish-dry-run.mjs",
    "scrape:local": "node scripts/scrape-local.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
